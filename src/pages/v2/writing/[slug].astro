---
import { getEntry, getCollection, render } from 'astro:content';
import { FEATURE_FLAGS } from '../../../lib/feature-flags';
import V2Layout from '../../../layouts/V2Layout.astro';
import V2Nav from '../../../lib/v2/V2Nav.svelte';

if (!FEATURE_FLAGS.writing) {
	return Astro.redirect('/v2');
}

const { slug } = Astro.params;
const post = await getEntry('writing', slug as string);

if (!post) {
	return Astro.redirect('/v2/writing');
}

const { Content, headings } = await render(post);

const allPosts = await getCollection('writing');
const sorted = allPosts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const idx = sorted.findIndex(p => p.id === slug);
const prevPost = sorted[idx + 1] ?? null;
const nextPost = sorted[idx - 1] ?? null;

const fmtDate = (d: Date) =>
	d.toLocaleDateString('en-US', { month: 'short', day: '2-digit', year: 'numeric' });

const navLinks = [
	{ label: 'Work', href: '/v2' },
	...(FEATURE_FLAGS.about ? [{ label: 'About', href: '/v2/about' }] : []),
	{ label: 'Writing', href: '/v2/writing', active: true },
	{ label: 'Contact', href: '/v2#contact' },
];

const tocHeadings = headings.filter(h => h.depth === 2);
---

<V2Layout title={`${post.data.title} — Alex Harlan`}>
	<style is:global>
		.vwp-body {
			background-image:
				radial-gradient(at 18% 8%, #3a1818 0, #0c0a09 55%),
				radial-gradient(at 85% 95%, #1a2a3a 0, transparent 60%);
			background-attachment: fixed;
			color: #f5f0ea;
			font-family: 'Inter', -apple-system, BlinkMacSystemFont, system-ui, sans-serif;
			min-height: 100vh;
		}
		.vwp-body a { color: inherit; text-decoration: none; }

		/* Reading progress */
		.vwp-progress {
			position: fixed; top: 0; left: 0; right: 0; height: 2px; z-index: 20;
			background: rgba(255,255,255,0.04);
			pointer-events: none;
		}
		.vwp-progress-bar {
			height: 100%; width: 0;
			background: #b91c1c;
			box-shadow: 0 0 10px rgba(185,28,28,0.7);
			transition: width .08s linear;
		}

		/* Page shell */
		.vwp-page {
			max-width: 1100px; margin: 0 auto;
			padding: 120px var(--v2-page-gutter) 120px;
		}

		/* Breadcrumbs */
		.vwp-crumbs {
			display: flex; align-items: center; gap: 10px;
			font-family: 'JetBrains Mono', monospace; font-size: 11px;
			letter-spacing: 2px; text-transform: uppercase;
			color: rgba(245,240,234,0.62); margin-bottom: 28px;
		}
		.vwp-crumbs a { color: rgba(245,240,234,0.62); }
		.vwp-crumbs a:hover { color: #f5f0ea; }
		.vwp-crumbs .vwp-sep { color: rgba(245,240,234,0.42); }
		.vwp-crumbs .vwp-here {
			color: #b91c1c; font-weight: 700;
			max-width: 360px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
		}

		/* Article header */
		.vwp-hero { max-width: 780px; margin: 0 auto 56px; }
		.vwp-kicker {
			display: flex; align-items: center; gap: 10px;
			font-family: 'JetBrains Mono', monospace; font-size: 11px;
			letter-spacing: 2px; text-transform: uppercase;
			color: rgba(245,240,234,0.62); margin-bottom: 18px;
		}
		.vwp-kicker-type { color: #b91c1c; font-weight: 700; }
		.vwp-kicker-rule { width: 18px; height: 1px; background: #3a352f; }

		h1.vwp-title {
			font-size: 60px; font-weight: 700; letter-spacing: -2px; line-height: 1.05;
			margin: 0 0 20px; color: #f5f0ea;
		}
		h1.vwp-title .vwp-dot { color: #b91c1c; }

		.vwp-dek {
			font-family: 'Source Serif 4', Georgia, serif;
			font-size: 22px; line-height: 1.5;
			color: rgba(245,240,234,0.62); font-weight: 400; font-style: italic;
			max-width: 640px; margin: 0 0 28px;
		}

		.vwp-byline {
			display: flex; align-items: center; gap: 16px;
			padding: 14px 0;
			border-top: 1px solid #2c2823; border-bottom: 1px solid #2c2823;
			font-family: 'JetBrains Mono', monospace; font-size: 12px;
			color: rgba(245,240,234,0.62); letter-spacing: 0.4px;
			flex-wrap: wrap;
		}
		.vwp-author {
			display: flex; align-items: center; gap: 10px;
			padding-right: 16px; border-right: 1px solid #2c2823;
			color: #f5f0ea; font-family: 'Inter', sans-serif; font-weight: 600;
		}
		.vwp-avatar {
			width: 28px; height: 28px; border-radius: 50%;
			background: #b91c1c;
			display: flex; align-items: center; justify-content: center;
			color: #fff; font-weight: 800; font-size: 11px; font-family: 'Inter', sans-serif;
			flex-shrink: 0;
		}
		.vwp-byline-meta { display: flex; gap: 16px; flex-wrap: wrap; }
		.vwp-byline-meta .item { display: flex; align-items: center; gap: 6px; }
		.vwp-byline-meta .k { color: rgba(245,240,234,0.42); }
		.vwp-byline-tags { margin-left: auto; display: flex; gap: 6px; flex-wrap: wrap; }
		.vwp-tag {
			font-family: 'JetBrains Mono', monospace; font-size: 10px; letter-spacing: 0.4px;
			color: rgba(245,240,234,0.62); padding: 2px 8px; border-radius: 6px;
			background: #141210; border: 1px solid #2c2823;
		}

		/* 3-column layout */
		.vwp-layout {
			display: grid; grid-template-columns: 1fr minmax(0, 720px) 1fr;
			gap: 48px; align-items: start;
		}

		/* TOC rail */
		.vwp-toc-rail {
			grid-column: 1; position: sticky; top: 110px; padding-top: 6px; min-width: 0;
		}
		.vwp-rail-head {
			font-family: 'JetBrains Mono', monospace; font-size: 10px;
			letter-spacing: 2px; text-transform: uppercase;
			color: rgba(245,240,234,0.42); margin: 0 0 12px;
		}
		.vwp-toc { list-style: none; margin: 0; padding: 0; border-left: 1px solid #2c2823; }
		.vwp-toc li { margin: 0; }
		.vwp-toc a {
			display: block; padding: 7px 14px; font-size: 12.5px;
			color: rgba(245,240,234,0.62); line-height: 1.4;
			border-left: 2px solid transparent; margin-left: -1px;
			transition: color .15s, border-color .15s;
		}
		.vwp-toc a:hover { color: #f5f0ea; }
		.vwp-toc a.active { color: #f5f0ea; border-left-color: #b91c1c; font-weight: 500; }

		/* Article column */
		.vwp-article { grid-column: 2; min-width: 0; }

		/* Share rail */
		.vwp-share-rail {
			grid-column: 3; position: sticky; top: 110px; padding-top: 6px;
		}
		.vwp-share { display: flex; flex-direction: column; gap: 6px; }
		.vwp-share button, .vwp-share a {
			all: unset; cursor: pointer; box-sizing: border-box;
			display: flex; align-items: center; gap: 10px;
			padding: 9px 12px; border-radius: 8px;
			font-family: 'JetBrains Mono', monospace; font-size: 11px;
			color: rgba(245,240,234,0.62);
			border: 1px solid #2c2823; background: rgba(255,255,255,0.02);
			transition: color .15s, border-color .15s, background .15s;
		}
		.vwp-share button:hover, .vwp-share a:hover {
			color: #f5f0ea; border-color: #b91c1c; background: rgba(185,28,28,0.08);
		}
		.vwp-share-icon {
			width: 14px; height: 14px; display: inline-flex;
			align-items: center; justify-content: center; color: #b91c1c;
		}

		/* Prose */
		.vwp-prose {
			font-family: 'Source Serif 4', Georgia, serif;
			counter-reset: section;
		}
		.vwp-prose p,
		.vwp-prose ul,
		.vwp-prose ol {
			font-size: 19px; line-height: 1.75; color: #f5f0ea; margin: 0 0 26px;
		}
		/* Drop cap on first paragraph */
		.vwp-prose > p:first-child {
			font-size: 22px; line-height: 1.6; font-weight: 500;
		}
		.vwp-prose > p:first-child::first-letter {
			font-size: 64px; font-weight: 700; float: left;
			line-height: 0.9; padding: 6px 10px 0 0; color: #b91c1c;
			font-family: 'Inter', sans-serif;
		}
		.vwp-prose h2 {
			counter-increment: section;
			font-family: 'Inter', sans-serif;
			font-size: 30px; font-weight: 700; letter-spacing: -0.8px; line-height: 1.2;
			color: #f5f0ea; margin: 52px 0 18px;
			display: flex; align-items: baseline; gap: 14px;
		}
		.vwp-prose h2::before {
			content: counter(section, decimal-leading-zero);
			font-family: 'JetBrains Mono', monospace; font-size: 12px;
			color: #b91c1c; font-weight: 700; letter-spacing: 1px; flex: 0 0 auto;
		}
		.vwp-prose h3 {
			font-family: 'Inter', sans-serif;
			font-size: 21px; font-weight: 600; letter-spacing: -0.3px;
			color: #f5f0ea; margin: 36px 0 12px;
		}
		.vwp-prose a {
			color: #dc2626;
			border-bottom: 1px solid rgba(220,38,38,0.4);
			transition: border-color .15s, color .15s;
		}
		.vwp-prose a:hover { color: #f5f0ea; border-bottom-color: #f5f0ea; }
		.vwp-prose ul, .vwp-prose ol { padding-left: 24px; }
		.vwp-prose li { margin: 0 0 8px; }

		.vwp-prose code {
			font-family: 'JetBrains Mono', monospace; font-size: 0.88em;
			background: #221f1c; color: #dc2626;
			padding: 2px 6px; border-radius: 4px; border: 1px solid #2c2823;
		}
		.vwp-prose pre {
			font-family: 'JetBrains Mono', monospace; font-size: 13.5px; line-height: 1.6;
			background: #1a1714; color: #f5f0ea;
			border: 1px solid #2c2823; border-radius: 10px;
			padding: 20px 22px; overflow-x: auto;
			box-shadow: 0 8px 24px rgba(0,0,0,0.35);
			margin: 0 0 26px;
		}
		.vwp-prose pre code {
			background: transparent; border: 0; padding: 0;
			color: inherit; font-size: inherit;
		}
		.vwp-prose blockquote {
			margin: 32px 0; padding: 6px 0 6px 24px;
			border-left: 2px solid #b91c1c;
			font-family: 'Source Serif 4', Georgia, serif; font-style: italic;
			font-size: 22px; line-height: 1.55; color: #f5f0ea;
		}
		.vwp-prose blockquote cite {
			display: block; margin-top: 10px;
			font-family: 'JetBrains Mono', monospace; font-size: 11px; font-style: normal;
			letter-spacing: 1px; text-transform: uppercase; color: rgba(245,240,234,0.62);
		}
		.vwp-prose blockquote p { margin: 0; font-size: inherit; }

		/* Pull quote */
		.vwp-pull {
			margin: 40px -24px; padding: 22px 28px;
			background: rgba(185,28,28,0.06);
			border: 1px solid rgba(185,28,28,0.22);
			border-left: 3px solid #b91c1c;
			border-radius: 0 12px 12px 0;
			font-family: 'Inter', sans-serif; font-size: 17px; line-height: 1.6;
			color: #f5f0ea;
		}
		.vwp-pull-label {
			display: block; font-family: 'JetBrains Mono', monospace;
			font-size: 10px; letter-spacing: 1.5px; text-transform: uppercase;
			color: #b91c1c; font-weight: 700; margin-bottom: 8px;
		}

		/* Figures */
		.vwp-fig { margin: 40px 0; }
		.vwp-fig-placeholder {
			height: 280px; border-radius: 10px;
			background: repeating-linear-gradient(135deg, #2c2823 0 12px, #1f1c19 12px 24px);
			border: 1px solid #322d27;
			display: flex; align-items: center; justify-content: center;
			color: rgba(245,240,234,0.42); font-family: 'JetBrains Mono', monospace; font-size: 11px;
		}
		.vwp-fig figcaption {
			font-family: 'JetBrains Mono', monospace; font-size: 11px;
			color: rgba(245,240,234,0.62); margin-top: 10px;
			text-align: center; letter-spacing: 0.4px;
		}

		/* Endmark */
		.vwp-endmark {
			font-family: 'JetBrains Mono', monospace; font-size: 12px;
			color: #b91c1c; letter-spacing: 2px; margin: 48px 0;
			display: flex; align-items: center; gap: 14px;
		}
		.vwp-endmark::before, .vwp-endmark::after {
			content: ''; flex: 1; height: 1px; background: #3a352f;
		}

		/* Author card */
		.vwp-author-card {
			display: grid; grid-template-columns: 72px 1fr; gap: 20px;
			padding: 24px; border-radius: 14px;
			background: #1a1714; border: 1px solid #2c2823;
			margin: 0 0 48px;
		}
		.vwp-avatar-lg {
			width: 72px; height: 72px; border-radius: 50%;
			background: #b91c1c;
			display: flex; align-items: center; justify-content: center;
			color: #fff; font-weight: 800; font-size: 28px; font-family: 'Inter', sans-serif;
			flex-shrink: 0;
		}
		.vwp-author-name {
			font-family: 'Inter', sans-serif; font-size: 16px; font-weight: 600; color: #f5f0ea;
		}
		.vwp-author-sub {
			font-family: 'JetBrains Mono', monospace; font-size: 11px;
			color: rgba(245,240,234,0.62); margin-top: 4px;
		}
		.vwp-author-bio {
			font-family: 'Inter', sans-serif; font-size: 14px;
			color: rgba(245,240,234,0.62); line-height: 1.55; margin: 10px 0 0;
		}
		.vwp-author-bio a {
			color: #dc2626; border-bottom: 1px solid rgba(220,38,38,0.4);
		}

		/* Next / prev */
		.vwp-next-head {
			font-family: 'JetBrains Mono', monospace; font-size: 11px;
			letter-spacing: 2px; text-transform: uppercase;
			color: rgba(245,240,234,0.62); margin: 0 0 16px;
			display: flex; align-items: center; gap: 10px;
		}
		.vwp-next-head .num { color: #b91c1c; font-weight: 700; }
		.vwp-next-head .rule { width: 18px; height: 1px; background: #3a352f; }
		.vwp-next-grid {
			display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-bottom: 48px;
		}
		.vwp-next-card {
			display: block; padding: 20px 22px; border-radius: 12px;
			background: #1a1714; border: 1px solid #2c2823;
			transition: border-color .15s, transform .15s;
			text-decoration: none; color: inherit;
		}
		.vwp-next-card:hover { border-color: #b91c1c; transform: translateY(-2px); }
		.vwp-next-dir {
			font-family: 'JetBrains Mono', monospace; font-size: 10px;
			letter-spacing: 1.5px; text-transform: uppercase;
			color: rgba(245,240,234,0.62); margin-bottom: 8px;
			display: flex; align-items: center; gap: 6px;
		}
		.vwp-next-card:hover .vwp-next-dir { color: #b91c1c; }
		.vwp-next-title {
			font-size: 17px; font-weight: 600; letter-spacing: -0.3px;
			color: #f5f0ea; line-height: 1.3;
		}
		.vwp-next-date {
			font-family: 'JetBrains Mono', monospace; font-size: 10.5px;
			color: rgba(245,240,234,0.42); margin-top: 6px;
		}
		.vwp-next-card--right { text-align: right; }
		.vwp-next-card--right .vwp-next-dir { justify-content: flex-end; }

		/* Back footer */
		.vwp-backwrap {
			margin-top: 48px; padding-top: 32px;
			border-top: 1px solid #2c2823;
			display: flex; justify-content: space-between; align-items: center;
			flex-wrap: wrap; gap: 16px;
		}
		.vwp-back {
			display: inline-flex; align-items: center; gap: 10px;
			font-family: 'JetBrains Mono', monospace; font-size: 12px;
			letter-spacing: 1.5px; text-transform: uppercase;
			color: #b91c1c; font-weight: 600;
			padding: 10px 16px; border-radius: 999px;
			border: 1px solid #b91c1c; background: rgba(185,28,28,0.08);
			transition: background .2s;
		}
		.vwp-back:hover { background: rgba(185,28,28,0.16); }
		.vwp-foot {
			font-family: 'JetBrains Mono', monospace;
			font-size: 11px; color: rgba(245,240,234,0.42);
		}

		@media (max-width: 1020px) {
			.vwp-layout { grid-template-columns: 1fr; }
			.vwp-toc-rail, .vwp-share-rail { display: none; }
			.vwp-article { grid-column: 1; }
		}
		@media (max-width: 720px) {
			.vwp-page { padding: 110px 20px 80px; }
			h1.vwp-title { font-size: 40px; letter-spacing: -1.5px; }
			.vwp-dek { font-size: 18px; }
			.vwp-prose p,
			.vwp-prose ul,
			.vwp-prose ol { font-size: 17px; }
			.vwp-next-grid { grid-template-columns: 1fr; }
			.vwp-pull { margin: 32px 0; }
		}
	</style>

	<div class="vwp-body">
		<div class="vwp-progress">
			<div class="vwp-progress-bar" id="progressBar"></div>
		</div>

		<V2Nav links={navLinks} />

		<main class="vwp-page">
			<div class="vwp-crumbs">
				<a href="/v2">Home</a>
				<span class="vwp-sep">/</span>
				<a href="/v2/writing">Writing</a>
				<span class="vwp-sep">/</span>
				<span class="vwp-here">{post.data.title}</span>
			</div>

			<header class="vwp-hero">
				<div class="vwp-kicker">
					<span class="vwp-kicker-type">{post.data.type}</span>
					<span class="vwp-kicker-rule"></span>
					{post.data.tags.join(' · ')}
				</div>

				<h1 class="vwp-title">{post.data.title}<span class="vwp-dot">.</span></h1>

				<p class="vwp-dek">{post.data.dek}</p>

				<div class="vwp-byline">
					<div class="vwp-author">
						<div class="vwp-avatar">A</div>
						Alex Harlan
					</div>
					<div class="vwp-byline-meta">
						<div class="item"><span class="k">published</span> {fmtDate(post.data.date)}</div>
						<div class="item"><span class="k">read</span> {post.data.readTime}</div>
						{post.data.wordCount && (
							<div class="item"><span class="k">words</span> ~{post.data.wordCount.toLocaleString()}</div>
						)}
					</div>
					<div class="vwp-byline-tags">
						{post.data.tags.map(t => <span class="vwp-tag">{t}</span>)}
					</div>
				</div>
			</header>

			<div class="vwp-layout">
				<!-- TOC -->
				{tocHeadings.length > 0 && (
					<aside class="vwp-toc-rail">
						<div class="vwp-rail-head">On this page</div>
						<ul class="vwp-toc">
							{tocHeadings.map(h => (
								<li>
									<a href={`#${h.slug}`} data-anchor={h.slug}>{h.text}</a>
								</li>
							))}
						</ul>
					</aside>
				)}

				<!-- Article -->
				<article class="vwp-article vwp-prose">
					<Content />

					<div class="vwp-endmark">■ end</div>

					<!-- Author card -->
					<div class="vwp-author-card">
						<div class="vwp-avatar-lg">A</div>
						<div>
							<div class="vwp-author-name">Alex Harlan</div>
							<div class="vwp-author-sub">Software Engineer · Mill Valley, CA</div>
							<p class="vwp-author-bio">
								I build small, honest things on the web.
								<a href="/v2/about">More about me →</a>
							</p>
						</div>
					</div>

					<!-- Next / Prev -->
					{(prevPost || nextPost) && (
						<>
							<div class="vwp-next-head">
								<span class="num">→</span><span class="rule"></span>Keep reading
							</div>
							<div class="vwp-next-grid">
								{prevPost ? (
									<a href={`/v2/writing/${prevPost.id}`} class="vwp-next-card">
										<div class="vwp-next-dir">← Older</div>
										<div class="vwp-next-title">{prevPost.data.title}</div>
										<div class="vwp-next-date">{fmtDate(prevPost.data.date)} · {prevPost.data.readTime}</div>
									</a>
								) : <div />}
								{nextPost ? (
									<a href={`/v2/writing/${nextPost.id}`} class="vwp-next-card vwp-next-card--right">
										<div class="vwp-next-dir">Newer →</div>
										<div class="vwp-next-title">{nextPost.data.title}</div>
										<div class="vwp-next-date">{fmtDate(nextPost.data.date)} · {nextPost.data.readTime}</div>
									</a>
								) : <div />}
							</div>
						</>
					)}
				</article>

				<!-- Share rail -->
				<aside class="vwp-share-rail">
					<div class="vwp-rail-head">Share</div>
					<div class="vwp-share">
						<button id="copyLink">
							<span class="vwp-share-icon">⎘</span> Copy link
						</button>
						<a href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(post.data.title)}&url=${encodeURIComponent(`https://alexharlan.dev/v2/writing/${post.id}`)}`} target="_blank">
							<span class="vwp-share-icon">◉</span> Twitter
						</a>
						<a href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(`https://alexharlan.dev/v2/writing/${post.id}`)}`} target="_blank">
							<span class="vwp-share-icon">in</span> LinkedIn
						</a>
						<a href={`mailto:?subject=${encodeURIComponent(post.data.title)}&body=${encodeURIComponent(`https://alexharlan.dev/v2/writing/${post.id}`)}`}>
							<span class="vwp-share-icon">✉</span> Email
						</a>
					</div>
				</aside>
			</div>

			<div class="vwp-backwrap">
				<a href="/v2/writing" class="vwp-back">
					<span style="font-size:14px">←</span>
					Back to writing
				</a>
				<div class="vwp-foot">© 2026 Alex Harlan · built with Astro + Svelte</div>
			</div>
		</main>
	</div>

	<script>
		// Reading progress bar
		const bar = document.getElementById('progressBar') as HTMLElement;
		function updateProgress() {
			const h = document.documentElement;
			const max = h.scrollHeight - h.clientHeight;
			bar.style.width = max > 0 ? `${Math.min(100, (h.scrollTop / max) * 100)}%` : '0%';
		}
		updateProgress();
		window.addEventListener('scroll', updateProgress, { passive: true });
		window.addEventListener('resize', updateProgress);

		// TOC active-section highlight
		const tocLinks = document.querySelectorAll<HTMLAnchorElement>('.vwp-toc a');
		const headings = Array.from(tocLinks)
			.map(a => document.getElementById(a.dataset.anchor!))
			.filter(Boolean) as HTMLElement[];

		function updateToc() {
			const y = window.scrollY + 160;
			let activeId = headings[0]?.id;
			for (const h of headings) {
				if (h.offsetTop <= y) activeId = h.id;
			}
			tocLinks.forEach(a => a.classList.toggle('active', a.dataset.anchor === activeId));
		}
		if (tocLinks.length) {
			updateToc();
			window.addEventListener('scroll', updateToc, { passive: true });
		}

		// Smooth-scroll TOC links
		tocLinks.forEach(a => {
			a.addEventListener('click', e => {
				const el = document.getElementById(a.dataset.anchor!);
				if (!el) return;
				e.preventDefault();
				window.scrollTo({ top: el.offsetTop - 100, behavior: 'smooth' });
				history.replaceState(null, '', `#${a.dataset.anchor}`);
			});
		});

		// Copy link
		document.getElementById('copyLink')?.addEventListener('click', () => {
			navigator.clipboard?.writeText(location.href);
		});
	</script>
</V2Layout>
