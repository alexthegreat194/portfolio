---
import V2Layout from '../../layouts/V2Layout.astro';
import V2Nav from '../../lib/v2/V2Nav.svelte';
import V2PageHeader from '../../lib/v2/V2PageHeader.svelte';
import { FEATURE_FLAGS } from '../../lib/feature-flags';

if (!FEATURE_FLAGS.about) {
	return Astro.redirect('/v2');
}

const profile = '/media/profile-final.jpg';

const navLinks = [
	{ label: 'Work', href: '/v2' },
	{ label: 'About', href: '/v2/about', active: true },
	...(FEATURE_FLAGS.writing ? [{ label: 'Writing', href: '/v2/writing' }] : []),
	{ label: 'Contact', href: '/v2#contact' },
];
---

<V2Layout title="About — Alex Harlan">
	<style is:global>
		.v2-about-body {
			background-image:
				radial-gradient(at 18% 8%, #3a1818 0, #0c0a09 55%),
				radial-gradient(at 85% 95%, #1a2a3a 0, transparent 60%);
			background-attachment: fixed;
			color: #f5f0ea;
			font-family: 'Inter', -apple-system, BlinkMacSystemFont, system-ui, sans-serif;
			min-height: 100vh;
		}
		.v2-about-body a { color: inherit; text-decoration: none; }

		/* Page shell */
		.v2-page {
			max-width: 1100px; margin: 0 auto;
			padding: 120px var(--v2-page-gutter) 120px;
		}

		/* Breadcrumbs */
		/* Two-column layout */
		.v2-layout {
			display: grid; grid-template-columns: 260px 1fr;
			gap: 64px; align-items: start;
		}

		/* Portrait */
		.v2-portrait {
			width: 260px; aspect-ratio: 4 / 5; border-radius: 14px; overflow: hidden;
			border: 1px solid #322d27;
		}
		.v2-portrait img {
			width: 100%; height: 100%; object-fit: cover; object-position: top;
			display: block;
		}

		/* Meta */
		.v2-meta {
			margin-top: 18px; font-family: 'JetBrains Mono', monospace;
			font-size: 11px; color: rgba(245,240,234,0.62); line-height: 1.85;
		}
		.v2-meta .k {
			color: rgba(245,240,234,0.38); display: inline-block; min-width: 56px;
		}

		/* Social chips */
		.v2-socials {
			margin-top: 22px; display: flex; flex-wrap: wrap; gap: 8px;
		}
		.v2-chip {
			font-family: 'JetBrains Mono', monospace; font-size: 11px; letter-spacing: 0.4px;
			padding: 7px 12px; border-radius: 999px;
			border: 1px solid #3a352f; color: rgba(245,240,234,0.62);
			transition: color .2s, border-color .2s;
		}
		.v2-chip:hover { color: #f5f0ea; border-color: #b91c1c; }

		/* Prose */
		.v2-prose { max-width: 680px; }
		.v2-prose h2 {
			font-family: 'JetBrains Mono', monospace;
			font-size: 11px; letter-spacing: 2px; text-transform: uppercase;
			color: #b91c1c; font-weight: 700;
			margin: 40px 0 14px;
			display: flex; align-items: center; gap: 12px;
		}
		.v2-prose h2 .rule {
			flex: 0 0 18px; height: 1px; background: #3a352f;
		}
		.v2-prose h2:first-child { margin-top: 0; }
		.v2-prose p {
			margin: 0 0 20px; font-size: 18px; line-height: 1.7; color: #f5f0ea;
		}
		.v2-prose p.lede {
			font-size: 22px; line-height: 1.55; font-weight: 500;
		}
		.v2-prose ul { padding-left: 20px; margin: 0 0 20px; }
		.v2-prose li {
			font-size: 17px; line-height: 1.7; color: #f5f0ea; margin: 0 0 6px;
		}

		/* Pull quote */
		.v2-pull {
			margin: 28px 0; padding: 18px 22px;
			border-left: 2px solid #b91c1c;
			background: rgba(185,28,28,0.06);
			border-radius: 0 10px 10px 0;
			font-family: 'JetBrains Mono', monospace;
			font-size: 14px; color: rgba(245,240,234,0.62); line-height: 1.6;
		}

		/* Footer back-link */
		.v2-backwrap {
			margin-top: 80px; padding-top: 32px;
			border-top: 1px solid #2c2823;
			display: flex; justify-content: space-between; align-items: center;
			flex-wrap: wrap; gap: 16px;
		}
		.v2-back {
			display: inline-flex; align-items: center; gap: 10px;
			font-family: 'JetBrains Mono', monospace;
			font-size: 12px; letter-spacing: 1.5px; text-transform: uppercase;
			color: #b91c1c; font-weight: 600;
			padding: 10px 16px; border-radius: 999px;
			border: 1px solid #b91c1c;
			background: rgba(185,28,28,0.08);
			transition: background .2s;
		}
		.v2-back:hover { background: rgba(185,28,28,0.16); }
		.v2-foot {
			font-family: 'JetBrains Mono', monospace;
			font-size: 11px; color: rgba(245,240,234,0.38);
		}

		@media (max-width: 820px) {
			.v2-page { padding: 110px 24px 80px; }
			.v2-layout { grid-template-columns: 1fr; gap: 36px; }
			.v2-portrait { width: 200px; }
		}
	</style>

	<div class="v2-about-body">
		<V2Nav links={navLinks} />

		<main class="v2-page">
			<!-- Breadcrumbs -->
			<div class="v2-crumbs">
				<a href="/v2">Home</a>
				<span class="sep">/</span>
				<span class="here">About</span>
			</div>

			<h1 class="v2-title">About<span class="dot">.</span></h1>
			<p class="v2-sub">The long version — background, how I work, and what I&rsquo;m after next.</p>

			<div class="v2-layout">
				<!-- Left rail -->
				<aside>
					<div class="v2-portrait">
						<img src={profile} alt="Alex Harlan" draggable="false" />
					</div>
					<div class="v2-meta">
						<div><span class="k">based</span> Mill Valley, CA</div>
						<div><span class="k">focus</span> backend systems</div>
						<div><span class="k">since</span> ~2020</div>
						<div><span class="k">email</span> alexharlan194@gmail.com</div>
					</div>
					<div class="v2-socials">
						<a class="v2-chip" href="https://github.com/alexthegreat194" target="_blank">GitHub</a>
						<a class="v2-chip" href="https://linkedin.com/in/alexander-harlan" target="_blank">LinkedIn</a>
					</div>
				</aside>

				<!-- Prose -->
				<article class="v2-prose">
					<p class="lede">
						Placeholder lead — one or two sentences that capture the whole person. Direct, a little
						opinionated, written in first person.
					</p>

					<h2><span class="rule"></span>Background</h2>
					<p>
						Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt
						ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation
						ullamco laboris nisi ut aliquip ex ea commodo consequat.
					</p>
					<p>
						Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat
						nulla pariatur. Excepteur sint occaecat cupidatat non proident, sunt in culpa qui officia
						deserunt mollit anim id est laborum.
					</p>

					<h2><span class="rule"></span>How I work</h2>
					<p>
						Sed ut perspiciatis unde omnis iste natus error sit voluptatem accusantium doloremque
						laudantium, totam rem aperiam, eaque ipsa quae ab illo inventore veritatis et quasi
						architecto beatae vitae dicta sunt explicabo.
					</p>
					<ul>
						<li>Placeholder principle one — how I approach a problem.</li>
						<li>Placeholder principle two — what I optimize for.</li>
						<li>Placeholder principle three — what I avoid.</li>
					</ul>

					<div class="v2-pull">
						Placeholder pull quote — a single line that captures how I think about the work.
					</div>

					<h2><span class="rule"></span>Outside work</h2>
					<p>
						Nemo enim ipsam voluptatem quia voluptas sit aspernatur aut odit aut fugit, sed quia
						consequuntur magni dolores eos qui ratione voluptatem sequi nesciunt. Placeholder paragraph
						about hobbies and interests outside engineering.
					</p>

					<h2><span class="rule"></span>What&rsquo;s next</h2>
					<p>
						At vero eos et accusamus et iusto odio dignissimos ducimus qui blanditiis praesentium
						voluptatum deleniti atque corrupti quos dolores et quas molestias excepturi. Placeholder
						closing paragraph about what I&rsquo;m looking for next.
					</p>
				</article>
			</div>

			<div class="v2-backwrap">
				<a href="/v2" class="v2-back">
					<span style="font-size:14px">←</span>
					Back to work
				</a>
				<div class="v2-foot">© 2026 Alex Harlan · built with Astro + Svelte</div>
			</div>
		</main>
	</div>
</V2Layout>
