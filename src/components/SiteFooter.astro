---
/** Public URL of this site's source repository (edit if the repo moves). */
const SITE_SOURCE_REPO = 'https://github.com/alexthegreat194/portfolio';
const ASTRO_HREF = 'https://astro.build';

const year = new Date().getFullYear();
---

<footer
	class="border-t border-gray-800 bg-gray-900 text-gray-500"
	role="contentinfo"
>
	<div
		class="mx-auto flex w-full max-w-5xl flex-col items-center justify-center gap-3 px-4 py-8 text-center text-sm sm:flex-row sm:flex-wrap sm:justify-between sm:gap-x-6 sm:gap-y-2 sm:text-left"
	>
		<p class="order-1 text-gray-500 sm:order-none">
			&copy; {year} Alex Harlan
		</p>
		<div
			class="order-2 flex flex-col items-center gap-2 sm:order-none sm:flex-row sm:gap-4"
		>
			<a
				href={SITE_SOURCE_REPO}
				target="_blank"
				rel="noopener noreferrer"
				class="text-red-800 underline decoration-red-900 underline-offset-2 transition-colors hover:text-red-600"
			>
				Site source on GitHub
			</a>
			<span class="hidden sm:inline" aria-hidden="true">·</span>
			<p class="text-gray-600">
				Built with{' '}
				<a
					href={ASTRO_HREF}
					target="_blank"
					rel="noopener noreferrer"
					class="font-medium text-red-900 transition-colors hover:text-red-700"
					>Astro</a
				>
			</p>
		</div>
	</div>
</footer>
